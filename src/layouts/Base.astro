---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'index' | 'compare' | 'convention' | 'about';
}
const { title, description = 'A Chrome extension that reads how any site moves and copies its curves and durations into your code.', current } = Astro.props;
const fullTitle = title === 'easeprint' ? title : `${title} · easeprint`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath d='M1 15C5 15 6 1 15 1' fill='none' stroke='%2322382b' stroke-width='2'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href="/">easeprint<b>.</b></a>
        <nav aria-label="Site">
          <a href="/" aria-current={current === 'index' ? 'page' : undefined}>Sites</a>
          <a href="/compare/" aria-current={current === 'compare' ? 'page' : undefined}>Compare</a>
          <a href="/convention/" aria-current={current === 'convention' ? 'page' : undefined}>The convention</a>
          <a href="/method/" aria-current={current === 'about' ? 'page' : undefined}>Method</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>Every number here was read from a browser on the capture date shown, or is marked as from notes with its date. Demos are our own code; links go to the source sites.</p>
        <p>Sites change. A measurement is true for its date.</p>
      </div>
    </footer>
  </body>
</html>
