---
import Base from '../layouts/Base.astro';
import PanelDemo from '../components/PanelDemo.astro';
import Print from '../components/Print.astro';
import Verdict from '../components/Verdict.astro';
import { leadTier, loadEntries } from '../lib/entries';
import { entryPrintTiers } from '../lib/print/entry';
import { POSTURES } from '../lib/schema';

const entries = await loadEntries();
const tiers = entries.reduce((n, e) => n + e.data.tiers.length, 0);
const honored = entries.filter((e) => e.honesty.reducedMotion === 'honored').length;
const dates = [...new Set(entries.map((e) => e.data.captured))].sort();
const counts = Object.fromEntries(POSTURES.map((p) => [p, entries.filter((e) => e.data.posture === p).length]));
const featured = entries.find((e) => e.data.site === 'stripe.com') ?? entries.find((e) => e.data.tiers.length > 0);
---
<Base title="easeprint" current="index">
  <section class="hero wrap">
    <div class="hero-text">
      <h1 class="display">How does that site feel so good?</h1>
      <p class="lede">
        easeprint is a Chrome extension that reads the motion on whatever page you're on. You get the curves and
        durations the site actually uses, drawn as one print, and you can copy them straight into CSS, Tailwind,
        Motion or SwiftUI.
      </p>
      <div class="btn-row hero-cta">
        <a class="btn btn-primary btn-lg" href="/easeprint-extension.zip" download>Download for Chrome</a>
        <a class="btn btn-lg" href="#install">How to install</a>
      </div>
      <p class="fine hero-note">
        Values are read from what the browser computed, so they're exact. Motion driven from JavaScript gets fitted
        from its frames and is marked that way. Free, and it only reads a page after you click it.
      </p>
    </div>
    <div class="hero-panel">
      {featured && <PanelDemo entry={featured} />}
    </div>
  </section>

  <section class="wrap read" aria-labelledby="read-title">
    <h2 class="h2" id="read-title">Reading a print</h2>
    <div class="read-grid">
      <p>Each ridge is one timing the site uses. Short, snappy ones sit near the core and slow ones sit further out, so a quick site makes a tight print.</p>
      <p>A ridge bulges where its curve runs ahead of the clock. An ease-out swells early, an ease-in late, and an overshoot pushes out past its neighbours.</p>
      <p>Thicker ridges showed up more. Broken ones are loops. The faint lines between are filled in from their neighbours so the whole thing reads as one surface.</p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="entries-title">
    <div class="list-head">
      <div>
        <h2 class="h2" id="entries-title">{entries.length} sites, measured</h2>
        <p class="fine list-note">Measured in a browser on {dates.join(', ')}. {tiers} tiers, and {honored} of {entries.length} sites honor reduced motion. Hover a print and it draws itself on that site's own lead curve.</p>
      </div>
      <div class="filter" role="group" aria-label="Filter by posture" data-filter>
        <button class="btn" type="button" aria-pressed="true" data-posture-filter="all">All <span class="n">{entries.length}</span></button>
        {POSTURES.map((p) => (
          <button class="btn" type="button" aria-pressed="false" data-posture-filter={p}>
            <i class="dot" data-posture={p} aria-hidden="true"></i>{p} <span class="n">{counts[p]}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="fine filter-status" aria-live="polite" data-filter-status></p>

    <ol class="grid">
      {entries.map((e) => {
        const lead = leadTier(e);
        return (
          <li class="card" data-posture={e.data.posture}>
            <a href={`/entries/${e.id}/`} class="card-link">
              <div class="card-plot">
                <Print
                  tiers={entryPrintTiers(e)}
                  label={`Motion fingerprint of ${e.data.site}, ${e.data.tiers.length} tiers`}
                  draw={lead ? { timingFunction: lead.timingFunction, durationMs: lead.durationMs, on: 'hover' } : undefined}
                />
              </div>
              <div class="card-body">
                <h3>{e.data.name}</h3>
                <p class="value card-site">{e.data.site}</p>
                {lead && (
                  <p class="value card-curve">
                    <span class="kicker">{lead.role}</span>{' '}
                    {lead.timingFunction.startsWith('linear(') ? 'linear() spring' : lead.timingFunction} · {lead.duration}
                  </p>
                )}
                <p class="card-tags">
                  <span class="tag" data-posture={e.data.posture}><i></i>{e.data.posture}{e.data.ambientKind ? `, ${e.data.ambientKind}` : ''}</span>
                  {e.data.status !== 'measured' && <span class="tag" data-status={e.data.status}>{e.data.status}</span>}
                </p>
                <p class="fine card-rm"><Verdict verdict={e.honesty.reducedMotion} /></p>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="wrap install" id="install" aria-labelledby="install-title">
    <h2 class="h2" id="install-title">Install it</h2>
    <p class="lede">It isn't on the Chrome Web Store yet, so for now it installs by hand. Takes about a minute.</p>
    <ol class="steps">
      <li><span class="value">1</span><p><a href="/easeprint-extension.zip" download>Download the zip</a> and unzip it.</p></li>
      <li><span class="value">2</span><p>Open <code>chrome://extensions</code>, turn on Developer mode in the top right, and click Load unpacked. Pick the <code>easeprint</code> folder.</p></li>
      <li><span class="value">3</span><p>Go to a site you like and click easeprint in the toolbar, or press <code>Alt</code> <code>Shift</code> <code>E</code>. Move around the page and the print fills in.</p></li>
    </ol>
    <p class="fine">It asks for nothing up front. Clicking it gives it the one tab you're on until you leave that page. Record from load asks for one site at a time. Nothing leaves your browser.</p>
  </section>
</Base>

<script>
  import '../scripts/print';

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-posture-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  function apply(posture: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.postureFilter === posture)));
    let shown = 0;
    cards.forEach((c) => {
      const show = posture === 'all' || c.dataset.posture === posture;
      c.hidden = !show;
      if (show) shown++;
    });
    if (status) status.textContent = posture === 'all' ? '' : `Showing ${shown} ${posture} ${shown === 1 ? 'entry' : 'entries'}.`;
    const url = new URL(location.href);
    if (posture === 'all') url.searchParams.delete('posture');
    else url.searchParams.set('posture', posture);
    history.replaceState(null, '', url);
  }
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.postureFilter!)));
  const initial = new URL(location.href).searchParams.get('posture');
  if (initial && buttons.some((b) => b.dataset.postureFilter === initial)) apply(initial);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 400px);
    gap: var(--s8);
    align-items: start;
    padding-block: var(--s9) var(--s8);
  }

  .hero-text {
    padding-top: var(--s6);
  }

  .hero .lede {
    margin-top: var(--s5);
  }

  .hero-cta {
    margin-top: var(--s6);
  }

  .btn-lg {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
    text-decoration: none;
  }

  .hero-note {
    margin-top: var(--s5);
    max-width: 34em;
  }

  .hero-panel {
    display: flex;
    justify-content: flex-end;
  }

  @media (width <= 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s7);
      padding-block: var(--s7);
    }

    .hero-text {
      padding-top: 0;
    }

    .hero-panel {
      justify-content: flex-start;
    }
  }

  .read {
    padding-block: var(--s6) var(--s8);
  }

  .read-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s6);
    margin-top: var(--s5);
    color: var(--ink-2);
    font-size: 15px;
  }

  @media (width <= 760px) {
    .read-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }
  }

  .list-note {
    margin-top: var(--s2);
    max-width: 40em;
  }

  .install {
    padding-top: var(--s9);
  }

  .install .lede {
    margin-top: var(--s3);
  }

  .steps {
    display: grid;
    gap: var(--s4);
    margin-block: var(--s6);
    max-width: 40em;
  }

  .steps li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--s3);
    font-size: 15px;
  }

  .steps .value {
    color: var(--muted);
    padding-top: 2px;
  }

  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s4);
    margin-top: var(--s6);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .filter .btn {
    text-transform: capitalize;
  }

  .filter .n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .filter .btn[aria-pressed="true"] .n {
    color: inherit;
    opacity: 0.7;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }

  .dot[data-posture="spatial"] {
    background: var(--spatial);
  }

  .dot[data-posture="material"] {
    background: var(--material);
  }

  .dot[data-posture="ambient"] {
    background: var(--ambient);
  }

  .filter-status {
    min-height: 1.6em;
    margin-top: var(--s2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--s4);
    margin-top: var(--s3);
  }

  .card[hidden] {
    display: none;
  }

  /* Lifted, not outlined. The hover rises on the utility tier and drops back on the exit tier. */
  .card-link {
    position: relative;
    display: flex;
    gap: var(--s4);
    height: 100%;
    padding: var(--s4);
    border-radius: var(--r3);
    background: var(--raised);
    box-shadow: var(--lift);
    text-decoration: none;
    transition: transform var(--dur-exit) var(--ease-exit);
  }

  /* The deeper shadow sits on a pseudo-element and fades, so only opacity and transform animate. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--lift-hover);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-exit) var(--ease-exit);
  }

  .card-link:hover {
    transform: translateY(-2px);
    transition: transform var(--dur-utility) var(--ease-utility);
  }

  .card-link:hover::after {
    opacity: 1;
    transition: opacity var(--dur-utility) var(--ease-utility);
  }

  .card-plot {
    flex: none;
    width: 84px;
    color: var(--ink);
  }

  .card-plot :global(svg) {
    width: 100%;
    height: auto;
  }

  .card-body {
    min-width: 0;
  }

  .card h3 {
    font: 600 17px/1.2 var(--font-text);
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
  }

  .card-site {
    color: var(--muted);
    margin-top: var(--s1);
  }

  .card-curve {
    margin-top: var(--s3);
    font-size: 12px;
  }

  .card-curve .kicker {
    font-size: 10px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    margin-top: var(--s3);
  }

  .card-rm {
    margin-top: var(--s2);
    font-size: 12px;
  }
</style>
